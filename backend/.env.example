# Copie este arquivo para ".env" e preencha com sua chave real.
# NUNCA commite o arquivo ".env" (ele já está no .gitignore).

OPENAI_API_KEY=sk-coloque-sua-chave-aqui

# Modelo usado para o chatbot do enigma.
OPENAI_MODEL=gpt-4o-mini

# Palavra-passe que libera o Enigma 5 (opcional; o padrão já é "hands on").
# Descomente para trocar sem mexer no código.
# PALAVRA_PASSE=hands on

# Origem(ns) do frontend autorizadas a chamar esta API (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173
